# Local development needs no configuration — the defaults below are what
# `npm run db:push && npm run db:seed` already assume. Copy to `.env` only
# if you want to change something.

# SQLite for local dev. For production, point this at Postgres and switch
# the provider in prisma/schema.prisma — see "Deploying" in the README.
DATABASE_URL="file:./prisma/dev.db"

# Owner sign-in password used by `npm run db:seed` (and by every demo deploy,
# which reseeds). Leave blank locally to have one generated and printed.
SEED_OWNER_PASSWORD=""
